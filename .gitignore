#! Terraform

# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Variable files containing secrets or environment-specific values
*.tfvars
*.tfvars.json

# Terraform plan files
*.tfplan
*.plan

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Lock file is generally committed for provider dependency consistency
.terraform.lock.hcl

# Folder used for trying out the modules recently created
modulestest/